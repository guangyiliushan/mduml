{
  "name": "@mduml/renderer-mermaid-playwright",
  "version": "1.2.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "test": "node --input-type=module -e \"const m = await import('./dist/index.js'); const r = m.createMermaidPlaywrightRenderer(); if (typeof r?.render !== 'function' || typeof r?.dispose !== 'function') process.exit(1);\""
  },
  "peerDependencies": {
    "playwright": "^1.44.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "dependencies": {
    "@mduml/core": "workspace:*",
    "@mermaid-js/layout-elk": "^0.2.1",
    "mermaid": "^11.14.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
