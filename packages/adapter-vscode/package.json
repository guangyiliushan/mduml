{
  "name": "@mduml/adapter-vscode",
  "version": "1.2.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsup && node ./scripts/copy-cli.mjs",
    "clean": "rimraf dist",
    "test": "node -e \"const fs = require('node:fs'); if (!fs.existsSync('./dist/extension.js')) process.exit(1);\"",
    "package:vsix": "node ./scripts/package-vsix.mjs"
  },
  "dependencies": {
    "@mduml/adapter-markdown-it": "workspace:*",
    "@mduml/runtime-mermaid": "workspace:*",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.5.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
