{
  "name": "uml-flow",
  "displayName": "UML Flow",
  "description": "在 VS Code Markdown 预览中渲染 Mermaid/PlantUML 流程图（横平竖直优先）",
  "version": "1.0.8",
  "publisher": "uml-flow",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.previewScripts": [
      "./dist/preview.global.js"
    ],
    "configuration": {
      "title": "UML Flow",
      "properties": {
        "umlFlow.debug": {
          "type": "boolean",
          "default": false,
          "description": "启用调试日志（影响渲染性能）"
        }
      }
    }
  }
}
